# Text normalization
* text=auto eol=lf
# Godot text files
*.gd text
*.tscn text
*.tres text
*.cfg text
*.json text
*.md text
# Binary files (no diff/merge)
*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.ogg binary
*.svg binary
*.import binary
# GDExtension native libraries — plain binary blobs.
# NOT LFS: HEAD stores them as normal blobs and the repo has no LFS objects;
# declaring an lfs filter made every addon binary show as permanently modified.
*.so binary
*.dll binary
*.dylib binary
*.wasm binary
*.a binary
